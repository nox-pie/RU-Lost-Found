{
  "name": "@ru-lost-found/api",
  "private": true,
  "license": "UNLICENSED",
  "version": "2.0.0",
  "description": "REST API for RU Lost & Found",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx src/scripts/seed.ts",
    "set-role": "tsx src/scripts/set-role.ts",
    "migrate-legacy": "tsx src/scripts/migrate-legacy.ts",
    "demo": "tsx src/scripts/demo.ts",
    "start:worker": "node dist/worker.js",
    "dev:worker": "tsx watch src/worker.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@ru-lost-found/shared": "*",
    "@sentry/node": "^11.1.0",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "multer": "^2.4.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "swagger-ui-dist": "^5.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.16.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-dist": "^3.30.6",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "mongodb-memory-server": "^10.4.3",
    "pino-pretty": "^13.0.0",
    "supertest": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^5.0.3"
  }
}
