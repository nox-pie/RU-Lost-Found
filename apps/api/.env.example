# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5001
LOG_LEVEL=debug

# MongoDB connection string (Atlas or a local replica set; transactions need a replica set).
# Use a different database from the old backend: its documents have a different shape.
MONGODB_URI=mongodb://127.0.0.1:27017/ru-lost-found-v2

# Public address of the web app (used for links in emails)
APP_URL=http://localhost:5173

# Run the background worker (email delivery, scheduled jobs) inside the API process
WORKER_ENABLED=true

# Comma-separated list of origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the app, used to find each client's real IP.
# 0 locally; in production 2 (Vercel rewrite + Render load balancer). Required in production.
TRUST_PROXY_HOPS=0

# Master secret (at least 32 random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SECRET=replace-me-with-a-long-random-secret-value

# Password hashing cost (12 in production; lower is faster for local development)
BCRYPT_ROUNDS=10

# Optional: Redis (e.g. Upstash). Without it, codes and rate limits live in memory.
REDIS_URL=

# Optional in development, required in production: Brevo API key for sending emails.
# Without it, emails (including sign-up codes) are printed to the API log.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@ru-lost-found.app
# Sender name; defaults to BRAND_NAME.
EMAIL_FROM_NAME=

# Branding used in emails (the web app's brand lives in apps/web/src/brand/brand.config.ts).
# The universities a deployment starts with live in seed/universities.json.
BRAND_NAME=RU Lost & Found
BRAND_PRIMARY_COLOR=#e63946
BRAND_BACKGROUND_COLOR=#fcf1e8

# Optional in development, required in production: Cloudinary image hosting.
# Without it, uploaded images are saved to apps/api/.uploads and served by the API.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Development only: write emails as JSON files into this folder instead of logging them
# DEV_EMAIL_DIR=.emails

# Optional: Sentry error tracking. Without a DSN, errors are only logged.
SENTRY_DSN=
# Defaults to NODE_ENV / the Git commit Render deploys (RENDER_GIT_COMMIT).
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Serve the OpenAPI document and Swagger UI at /api/v1/openapi.json and /api/v1/docs
API_DOCS_ENABLED=true

# Only for `npm run migrate-legacy`: the first version's database (read only).
LEGACY_MONGODB_URI=
