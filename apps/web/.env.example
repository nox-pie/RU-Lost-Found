# Settings of the web app. Vite builds them into the public JavaScript, so never put secrets here.
#
# Local development needs no env file at all: the dev server sends /api to the API on
# http://127.0.0.1:5001 (see vite.config.ts).
#
# Production values are set in Vercel (project ru-lost-found → Settings → Environment Variables).
# To make a local production build behave the same, copy this file to .env.production
# (git-ignored; Vite reads it only for `npm run build`).

# Sentry error tracking for the browser (project ru-lost-found-web). Off when empty.
VITE_SENTRY_DSN=

# Version tag on error reports. Leave empty: on Vercel it is filled from VERCEL_GIT_COMMIT_SHA.
VITE_RELEASE=
